# Server bind address and port.
# Keep MOOD_HOST as 127.0.0.1 when using Caddy as a reverse proxy.
MOOD_HOST=127.0.0.1
MOOD_PORT=5000

# Application storage and the public HTTPS origin used for the exact callback URL.
MOOD_DB_PATH=data/mood_barometer.sqlite3
MOOD_PUBLIC_BASE_URL=https://techx.example.com
MOOD_SESSION_COOKIE_SECURE=true

# NetHub Accounts confidential OIDC client. Never commit the real secret.
ACCOUNTS_ISSUER=https://auth.nethub.wiki
ACCOUNTS_CLIENT_ID=techx
ACCOUNTS_CLIENT_SECRET=replace-with-the-client-secret

# Optional development reload.
FASTAPI_RELOAD=0

# Optional deploy script service name.
# Note: deploy-first-run.sh reads this in bash before main.py loads .env,
# so set it as an exported shell variable if you need a custom service name:
# MOOD_SERVICE_NAME=techx-shude-mood-barometer.service
# MOOD_CONDA_ENV=techx-shude-mood-barometer
# MOOD_PYTHON_VERSION=3.12
